    "열기" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開く"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "翻开"
          }
        }
      }
    },
    "열기 모드에서는 칸을 누르면 열리고, 깃발 모드에서는 지뢰가 있다고 생각하는 칸에 깃발을 표시할 수 있어요." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Open mode, tap a square to open it; in Flag mode, flag squares you think hide a mine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開くモードではマスを押すと開き、旗モードでは地雷があると思うマスに旗を立てられます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在翻开模式下点击格子即可翻开；在旗子模式下可在你认为有雷的格子上插旗。"
          }
        }
      }
    },
    "열린 숫자 칸을 누르면 주변 깃발의 개수가 숫자와 같을 때 나머지 닫힌 칸을 한 번에 열 수 있어요." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap an open number when its flags match the number to open the remaining closed squares at once."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "周りの旗の数が数字と同じとき、開いた数字のマスを押すと残りの閉じたマスを一度に開けます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当周围旗子数与数字相同时，点击已翻开的数字格可一次翻开其余未翻开的格子。"
          }
        }
      }
    },
    "열린 칸" : {
