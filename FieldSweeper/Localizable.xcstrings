    "길게 누르면 열기와 깃발 동작을 반대로 사용할 수 있어요. 컴퓨터에서는 마우스 오른쪽 버튼으로 깃발을 표시할 수 있어요." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A long press does the opposite of Open or Flag. On a computer, right-click to flag."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長押しすると開くと旗の動作を逆にして使えます。パソコンではマウスの右ボタンで旗を立てられます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "长按可反向使用翻开和插旗操作。电脑上可用鼠标右键插旗。"
          }
        }
      }
    },
    "길은 상하좌우로만 연결할 수 있으며, 다른 길과 겹치거나 교차할 수 없어요." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paths connect only up, down, left and right, and can’t overlap or cross other paths."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "道は上下左右にだけつなげられ、ほかの道と重なったり交差したりできません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "路径只能上下左右连接，不能与其他路径重叠或交叉。"
          }
        }
      }
    },
    "길을 모두 지울까요?" : {
      "extractionState" : "stale",
