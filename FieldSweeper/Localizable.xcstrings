      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a mirror on a lilac square to switch between / and \\; the light’s path updates as you go."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "薄紫のマスの鏡を押すと / と \\ の向きが切り替わり、光の道がリアルタイムで表示されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
