            "value" : "撤销"
          }
        }
      }
    },
    "되돌리기 %lld" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Undo %lld"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "元に戻す %lld"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "撤销 %lld"
          }
        }
      }
    },
    "되돌리기는 초급 무제한, 중급 10회, 고급 5회, 전문가 3회까지 사용할 수 있어요." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Undo is unlimited on Beginner; Intermediate allows 10, Advanced 5 and Expert 3."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "元に戻すは初級では無制限、中級は10回、上級は5回、エキスパートは3回まで使えます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "撤销在初级无限制，中级可用 10 次，高级 5 次，专家 3 次。"
          }
        }
      }
    },
    "되돌리기는 횟수 제한 없이 사용할 수 있지만, 사용할 때마다 조작 횟수에 1회 추가돼요." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Undo has no limit, but each use adds one to your move count."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "元に戻すは回数制限なく使えますが、使うたびに操作回数が1回増えます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "撤销没有次数限制，但每次使用都会让步数加 1。"
          }
        }
      }
    },
    "되돌리기로 다시 살릴 수 있어요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can bring them back with Undo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "元に戻すで復元できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可以用撤销恢复。"
          }
        }
      }
    },
    "두 손가락으로 벌리거나 오므리면 게임판을 확대하거나 축소할 수 있어요." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinch with two fingers to zoom the board in or out."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2本の指で広げたりつまんだりすると、盤を拡大・縮小できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用两根手指张开或捏合即可放大或缩小棋盘。"
          }
        }
      }
    },
