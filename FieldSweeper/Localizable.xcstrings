    },
    "숫자가 있는 칸에서 다시 드래그하면 연결된 길을 지우고 새로 그릴 수 있어요." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag from a numbered square again to clear its path and draw a new one."
