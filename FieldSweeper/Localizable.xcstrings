    "모든 문제는 추측 없이 논리적으로 풀 수 있어요." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every puzzle can be solved with logic alone, no guessing."
